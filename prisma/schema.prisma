// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
// 编写表结构
// 创建模型表
model Model {
  id Int @id @default(autoincrement()) // 自增id
  name String
  description String
  url String
  md5 String @unique // 唯一不可重复
  user User @relation(fields: [userId], references: [id]) // 外键
  userId Int // 关联id 将userId关联到user表的id
}
// 创建user表 一个用户可以上传多个模型
model User {
  id Int @id @default(autoincrement()) // 自增id
  name String
  password String
  models Model[] // 一对多的关系
}
// 创建一个技术文章表 目前有两种类型 前端 后端
model TeachShare {
  id Int @id @default(autoincrement()) // 自增id
  userId Int // 预留关联将userId关联到user表的id 暂定为liorian
  title String
  content String
}